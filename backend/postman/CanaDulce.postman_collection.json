    {
      "name": "00 - Estado del servidor y MySQL",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('MySQL conectado',()=>pm.expect(pm.response.json().baseDeDatos).to.eql('conectada'));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Registrar estudiante de demostración",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/estudiantes",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"alias\": \"{{aliasPrueba}}\",\n  \"grado\": 3,\n  \"codigoAcceso\": \"{{codigoPrueba}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s=Date.now().toString();pm.collectionVariables.set('sufijo',s);pm.collectionVariables.set('aliasPrueba','Demo'+s);if(!pm.variables.get('codigoPrueba'))throw new Error('Define codigoPrueba (6-32 caracteres) en un entorno local.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const p=pm.response.json();pm.collectionVariables.set('idEstudiante',p.idEstudiante);pm.test('Sin secretos',()=>{pm.expect(p).not.to.have.property('codigoAccesoHash');pm.expect(p).not.to.have.property('codigoAcceso');});"
            ]
          }
        }
      ]
    },
